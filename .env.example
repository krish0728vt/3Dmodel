# SHAH INDUSTRIES local environment. Copy to .env and fill in what you need.
# Secrets belong here only, never in config/local.json.

# Optional. Select natural-language provider: ollama, openai, or none.
# Ollama/local AI does not need an API key. OpenAI uses OPENAI_API_KEY below.
SHAH_AI_PROVIDER=ollama
SHAH_OLLAMA_URL=http://127.0.0.1:11434
SHAH_OLLAMA_MODEL=qwen2.5-coder:7b
SHAH_AI_TIMEOUT_SECONDS=120

# Optional. Enables OpenAI natural-language prompt parsing when
# SHAH_AI_PROVIDER=openai. Leave blank when using Ollama or manual mode.
#
# Manual CAD, operation plans, projects, revisions, parametrics, engineering
# checks, assemblies, exports, and evaluation are deterministic and work without
# any AI provider.
OPENAI_API_KEY=

# Optional. Overrides the OpenAI model used for prompt parsing.
# OPENAI_MODEL=
