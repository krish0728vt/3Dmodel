# SHAH INDUSTRIES local environment. Copy to .env and fill in what you need.
# Secrets belong here only, never in config/local.json.

# Optional. Enables natural-language prompt parsing.
# Leave blank to run without AI: manual CAD, operation plans, projects,
# revisions, parametrics, engineering checks, assemblies, exports, and the
# evaluation suite are all deterministic and work without a key.
OPENAI_API_KEY=

# Optional. Overrides the model used for prompt parsing.
# OPENAI_MODEL=
